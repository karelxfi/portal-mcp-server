# Test files (don't commit to main repo)
test-*.mjs
test-*.js
test-*.sh
*-test.mjs
*-test.js
demo.ts
demo.mjs
demo.js
export-demo.ts
examples/

# Temporary test data
/tmp/
*.tmp
*.temp
.scratch/

# Database files (if we add SQLite/DuckDB)
*.db
*.sqlite
*.sqlite3
*.duckdb
*.parquet
*.arrow
# Anchored to the repository root. Unanchored, `cache/` matches any directory
# of that name at any depth, so it swallowed src/cache/ and hid
# src/cache/datasets.test.ts from the repository: the suite ran locally and
# never ran in CI.
/cache/
/data/

# Local planning and working notes (public Markdown is tracked)
CLAUDE.md
plans/
# docs/ holds local working notes by default. A document written for people
# outside this checkout has to be named here, because `git add` skips an
# ignored path without saying so: docs/explorer-design.md was written, added,
# committed, referenced from the changelog and the pull request template, and
# never actually entered the repository.
docs/*
!docs/explorer-design.md
V*_SCOPE.md
test-report-*.md
NOTES*.md
TODO*.md

# Environment files with secrets
.env
.env.*
!.env.example

# Claude project files (local configuration)
.claude/
.agents/
!.agents/
!.agents/plugins/
!.agents/plugins/marketplace.json

# Package manager lock files (package-lock.json is tracked; it is the only lockfile)
yarn.lock

# Coverage reports
coverage/
.nyc_output/

# Backup files
*.backup
*.bak
*.old

# Local dev files
.mcp.json
!plugins/*/.mcp.json
mcp-config.json
charts-demo.html
V*_SCOPE.md

# Generated Explorer bundle: built by scripts/ensure-app-bundle.mjs and npm run build
src/generated/

# Layout baselines are recorded per platform; only the CI platform is committed.
scripts/app-ui-baselines/layout-*.json
!scripts/app-ui-baselines/layout-linux.json

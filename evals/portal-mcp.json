{
  "version": 1,
  "description": "Pinned questions for the model-in-the-loop eval. Every positive case names a fixed block, slot, or timestamp window so the answer never moves, and every answer was verified against the Portal rows returned by the reference calls. Negative cases expect the model to say the question cannot be answered.",
  "defaults": {
    "max_tool_calls": 8,
    "min_pass_rate": 0.9,
    "max_tool_call_growth": 0.2,
    "refusal_phrases": [
      "not supported",
      "unsupported",
      "unknown network",
      "not a supported",
      "does not support",
      "not available",
      "isn't available",
      "is not available",
      "invalid",
      "malformed",
      "not a valid",
      "not valid",
      "cannot",
      "can't",
      "unable",
      "future",
      "not indexed",
      "not yet indexed",
      "after the latest",
      "no data",
      "hasn't happened",
      "has not happened"
    ]
  },
  "cases": [

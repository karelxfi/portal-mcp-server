{
  "name": "sqd-portal-mcp",
  "version": "0.7.7",
  "description": "MCP server wrapping SQD Portal API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sqd-portal-mcp": "dist/index.js"
  },
  "scripts": {
    "build:app-ui": "node scripts/build-app-ui.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "build": "npm run build:app-ui && tsc",
    "dev:ui": "vite",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "predev": "npm run build:app-ui",
    "dev": "tsx src/index.ts",
    "predev:http": "npm run build:app-ui",
    "dev:http": "tsx src/http.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "tsx scripts/smoke-test.ts",
    "test:tools": "tsx scripts/test-tools.ts",
    "test:routing": "tsx scripts/test-routing.ts",
    "test:substrate": "tsx scripts/test-substrate.ts",
    "test:conversations": "tsx scripts/test-conversations.ts",
    "prompt:taxonomy": "tsx scripts/prompt-taxonomy.ts",
    "test:negative": "tsx scripts/test-negative.ts",
    "test:quality": "tsx scripts/test-quality.ts",
    "typecheck:ui": "tsc -p tsconfig.ui.json",
    "test:ui": "npm run build:preview && tsx scripts/test-ui.ts",
    "test:all": "npm run build && npm test && npm run test:tools && npm run test:routing && npm run test:substrate && npm run test:conversations && npm run test:negative && npm run test:quality",
    "test:ci": "npm run test:all",
    "test:release": "npm run test:ci && npm run typecheck:ui && npm run test:ui",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/hashes": "^1.8.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@wick-charts/react": "^0.3.4",
    "prom-client": "^15.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@cloudflare/workers-types": "^4.20250110.0",
    "@storybook/addon-mcp": "^0.5.0",
    "@storybook/html-vite": "^10.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.0",
    "playwright": "^1.59.1",
    "storybook": "^10.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.8"
  }
}

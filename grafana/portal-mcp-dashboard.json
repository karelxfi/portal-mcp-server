          "placement": "right"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (tool) (increase(mcp_tool_calls_total{status=\"success\",tool=~\"$tool\"}[$__interval]))",
          "legendFormat": "{{tool}}",
          "refId": "A"

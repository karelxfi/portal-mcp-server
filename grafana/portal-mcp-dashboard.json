      "type": "timeseries",
      "description": "Live Prometheus scrape data from /metrics. Use the Loki panels below for long-range event history when Prometheus retention or scraping is missing."
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
